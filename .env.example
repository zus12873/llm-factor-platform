# Factor Platform environment template.
# Copy to `.env` (repo root, gitignored) and fill real values.
# Real secrets live ONLY in local `.env`; never commit them.
# Settings loads `.env` relative to the current working directory (repo root).

# --- Application ---
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/runtime/factor_platform.db
ARTIFACT_ROOT=./data/artifacts
JOB_ROOT=./data/runtime/jobs
# Random 32+ byte string used to sign session cookies (required outside tests).
SESSION_COOKIE_SECRET=
# Random 32+ byte string used to sign execution manifests.
MANIFEST_SIGNING_KEY=

# --- Wind research database (only required when WIND_ENABLED=true) ---
WIND_ENABLED=false
WIND_HOST=
WIND_PORT=3306
WIND_USER=
WIND_PASSWORD=
WIND_DATABASE=

# --- Trust boundary B4: internal data -> external model services ---
# Wind raw data, credentials, internal source and full report bodies never leave.
# LOCAL_ONLY_MODE=true forbids every external model call outright: PDFs are read
# locally, fields come from the local catalog, and formulas are confirmed by hand.
LOCAL_ONLY_MODE=false
# Opt in to sending a bounded, redacted slice of a research report. Off by default.
OUTBOUND_ALLOW_REPORT_EXCERPT=false
OUTBOUND_MAX_EXCERPT_CHARS=2000

# --- Kimi LLM providers ---
# Preferred: a healthy Coding Plan endpoint. Fallback: pay-as-you-go API.
KIMI_CODING_BASE_URL=
KIMI_CODING_API_KEY=
KIMI_CODING_MODEL=
KIMI_CODING_REASONING_EFFORT=
KIMI_METERED_BASE_URL=https://api.moonshot.cn/v1
KIMI_METERED_API_KEY=
# Provider-specific model ids take precedence; KIMI_MODEL remains the legacy
# fallback for either provider.
KIMI_METERED_MODEL=
KIMI_METERED_REASONING_EFFORT=
KIMI_MODEL=
