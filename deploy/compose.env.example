# Copy to deploy/compose.env and fill in. Never commit the filled copy.
#   cp deploy/compose.env.example deploy/compose.env
# Then: docker compose --env-file deploy/compose.env -f deploy/compose.yaml up --build -d
# deploy/compose.env is gitignored. Do not use deploy/.env for this recipe.
#
# SESSION_COOKIE_SECRET and MANIFEST_SIGNING_KEY must be random 32+ byte strings:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_COOKIE_SECRET=
MANIFEST_SIGNING_KEY=

# Wind read replica. Rotate the previously exposed credentials before enabling.
WIND_ENABLED=false
WIND_HOST=
WIND_PORT=3306
WIND_USER=
WIND_PASSWORD=
WIND_DATABASE=

# Model providers. Leave empty to run offline.
KIMI_CODING_BASE_URL=
KIMI_CODING_API_KEY=
KIMI_METERED_API_KEY=
KIMI_MODEL=

# true forbids every external model call.
LOCAL_ONLY_MODE=false
